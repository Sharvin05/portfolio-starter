# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile → Add site)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (https://resend.com → API Keys). The "from" address must be on a domain you've verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Portfolio <contact@your-domain.com>"
# Your private inbox. Server-only: never shown to visitors.
CONTACT_TO_EMAIL=

# Optional: load content from another folder instead of ./content (path relative to this app)
# SITE_CONTENT_DIR=../my-content

# Optional analytics. Each one is off unless its key is set.
# Visitors from the EU, EEA, UK and Switzerland see a consent banner first (country from Vercel's or Cloudflare's IP header).
# Google Analytics 4 (https://analytics.google.com → Admin → Data streams → Measurement ID)
NEXT_PUBLIC_GA_ID=
# PostHog (https://app.posthog.com → Project settings → Project API key). Use https://eu.i.posthog.com for EU projects.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
